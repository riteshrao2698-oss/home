<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>About — B Ritesh Rao</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=DM+Sans:wght@300;400;500;600&family=Syne:wght@700;800&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #F5F2EC;
    --bg2: #EDE9E0;
    --ink: #0F0E0B;
    --ink2: #3A3830;
    --ink3: #7A7668;
    --accent: #1A3C34;
    --accent2: #2D6A5C;
    --gold: #B89A5A;
    --warm: #E8DFD0;
    --border: rgba(15,14,11,0.1);
    --serif: 'Instrument Serif', Georgia, serif;
    --sans: 'DM Sans', system-ui, sans-serif;
    --display: 'Syne', sans-serif;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body {
    font-family: var(--sans);
    background: var(--bg);
    color: var(--ink);
    overflow-x: hidden;
    font-size: 16px;
    line-height: 1.6;
  }

  /* ── NAV ── */
  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    display: flex; align-items: center; justify-content: space-between;
    padding: 22px 60px;
    background: rgba(245,242,236,0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .nav-logo {
    font-family: var(--display);
    font-size: 15px; font-weight: 800;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
  }
  .nav-links { display: flex; gap: 36px; list-style: none; }
  .nav-links a {
    font-size: 13px; font-weight: 500; letter-spacing: 0.04em;
    color: var(--ink2); text-decoration: none;
    transition: color 0.2s;
  }
  .nav-links a:hover { color: var(--accent); }
  .nav-links a.active { color: var(--accent); }
  .nav-cta {
    font-size: 13px; font-weight: 600; letter-spacing: 0.04em;
    color: #fff; background: var(--accent);
    padding: 10px 22px; border-radius: 4px;
    text-decoration: none;
    transition: background 0.2s, transform 0.15s;
  }
  .nav-cta:hover { background: var(--accent2); transform: translateY(-1px); }

  /* ── SECTION BASE ── */
  section { padding: 100px 60px; }
  .section-label {
    font-size: 11px; font-weight: 600; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--gold);
    margin-bottom: 16px;
    display: flex; align-items: center; gap: 10px;
  }
  .section-label::before { content:''; display:block; width:24px; height:1px; background:var(--gold); }
  .section-h2 {
    font-family: var(--serif);
    font-size: clamp(32px, 4vw, 52px);
    line-height: 1.1; letter-spacing: -0.01em;
    color: var(--ink); margin-bottom: 20px;
  }
  .section-h2 em { font-style: italic; color: var(--accent); }
  .section-body {
    font-size: 17px; font-weight: 300; color: var(--ink2);
    line-height: 1.75; max-width: 620px;
  }

  /* ── ABOUT HERO ── */
  #about-hero {
    min-height: 100vh;
    display: grid; grid-template-columns: 1fr 1fr;
    align-items: center;
    padding: 140px 60px 100px;
    gap: 80px;
    position: relative;
    overflow: hidden;
    background: var(--bg);
  }
  .about-hero-bg {
    position: absolute; top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    font-family: var(--display);
    font-size: clamp(80px, 14vw, 200px);
    font-weight: 800; letter-spacing: -0.04em;
    color: rgba(15,14,11,0.03);
    white-space: nowrap;
    pointer-events: none; user-select: none;
    z-index: 0;
  }
  .about-hero-left { position: relative; z-index: 1; }
  .hero-eyebrow {
    display: inline-flex; align-items: center; gap: 10px;
    font-size: 11px; font-weight: 600; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--gold);
    margin-bottom: 28px;
  }
  .hero-eyebrow::before {
    content: ''; display: block;
    width: 32px; height: 1px; background: var(--gold);
  }
  .about-name {
    font-family: var(--serif);
    font-size: clamp(44px, 5.5vw, 74px);
    line-height: 1.06; letter-spacing: -0.01em;
    color: var(--ink); margin-bottom: 10px;
  }
  .about-name em { font-style: italic; color: var(--accent); }
  .about-headline {
    font-family: var(--sans);
    font-size: 14px; font-weight: 500; letter-spacing: 0.06em;
    text-transform: uppercase; color: var(--ink3);
    margin-bottom: 32px;
  }
  .about-intro {
    font-size: 17px; font-weight: 300; color: var(--ink2);
    line-height: 1.75; max-width: 500px; margin-bottom: 44px;
  }
  .about-intro strong { font-weight: 500; color: var(--ink); }
  .hero-actions { display: flex; gap: 16px; align-items: center; }
  .btn-primary {
    font-family: var(--sans); font-size: 14px; font-weight: 600;
    letter-spacing: 0.03em;
    background: var(--accent); color: #fff;
    padding: 15px 30px; border-radius: 4px;
    text-decoration: none;
    transition: background 0.2s, transform 0.15s;
    display: inline-block;
  }
  .btn-primary:hover { background: var(--accent2); transform: translateY(-2px); }
  .btn-ghost {
    font-family: var(--sans); font-size: 14px; font-weight: 500;
    letter-spacing: 0.03em;
    color: var(--ink); text-decoration: none;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 2px;
    transition: color 0.2s, border-color 0.2s;
  }
  .btn-ghost:hover { color: var(--accent); border-color: var(--accent); }

  /* Photo side */
  .about-hero-right {
    position: relative; z-index: 1;
    display: flex; flex-direction: column; align-items: center;
  }
  .photo-frame {
    position: relative;
    width: 380px; max-width: 100%;
  }
  .photo-frame::before {
    content: '';
    position: absolute;
    top: 20px; left: 20px; right: -20px; bottom: -20px;
    border: 2px solid var(--gold);
    border-radius: 10px;
    z-index: 0;
    opacity: 0.4;
  }
  .photo-frame img {
    position: relative; z-index: 1;
    width: 100%;
    border-radius: 8px;
    display: block;
    object-fit: cover;
    filter: grayscale(8%) contrast(1.03);
    box-shadow: 0 24px 60px rgba(0,0,0,0.15);
  }
  .photo-badge {
    position: absolute; bottom: -16px; right: -16px; z-index: 2;
    background: var(--accent); color: #fff;
    border-radius: 6px; padding: 14px 18px;
    box-shadow: 0 8px 24px rgba(26,60,52,0.3);
    text-align: center;
  }
  .photo-badge-num {
    font-family: var(--display); font-size: 26px; font-weight: 800;
    line-height: 1;
  }
  .photo-badge-label {
    font-size: 10px; font-weight: 500; letter-spacing: 0.08em;
    text-transform: uppercase; opacity: 0.7; margin-top: 3px;
  }

  /* ── SUMMARY SECTION ── */
  #summary { background: var(--bg2); }
  .summary-inner {
    display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: start;
  }
  .summary-text p {
    font-size: 17px; font-weight: 300; color: var(--ink2);
    line-height: 1.8; margin-bottom: 20px;
  }
  .summary-text p:last-child { margin-bottom: 0; }
  .summary-text strong { font-weight: 500; color: var(--ink); }

  .summary-aside { display: flex; flex-direction: column; gap: 16px; }
  .aside-card {
    background: #fff; border: 1px solid var(--border);
    border-radius: 8px; padding: 26px 28px;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .aside-card:hover { transform: translateX(4px); box-shadow: 0 8px 30px rgba(0,0,0,0.06); }
  .aside-card-icon {
    font-size: 22px; margin-bottom: 12px;
  }
  .aside-card-title {
    font-size: 14px; font-weight: 600; color: var(--ink); margin-bottom: 6px;
  }
  .aside-card-body {
    font-size: 13px; color: var(--ink3); line-height: 1.6; font-weight: 300;
  }

  /* ── SKILLS ── */
  #skills { background: var(--bg); }
  .skills-grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 24px; margin-top: 56px;
  }
  .skill-card {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 36px 32px;
    position: relative; overflow: hidden;
    transition: transform 0.25s, box-shadow 0.25s;
  }
  .skill-card:hover { transform: translateY(-4px); box-shadow: 0 20px 60px rgba(0,0,0,0.09); }
  .skill-card::after {
    content: '';
    position: absolute; bottom: 0; left: 0; right: 0;
    height: 3px; background: var(--accent);
    transform: scaleX(0); transform-origin: left;
    transition: transform 0.3s ease;
  }
  .skill-card:hover::after { transform: scaleX(1); }
  .skill-card.featured {
    background: var(--accent); color: #fff;
    border-color: transparent;
    grid-column: span 1;
  }
  .skill-card.featured .skill-tag { background: rgba(255,255,255,0.15); color: rgba(255,255,255,0.85); }
  .skill-card.featured .skill-name { color: #fff; }
  .skill-card.featured .skill-desc { color: rgba(255,255,255,0.65); }
  .skill-card.featured::after { background: var(--gold); }
  .skill-tag {
    display: inline-block;
    font-size: 10px; font-weight: 600; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--accent);
    background: rgba(26,60,52,0.08); border-radius: 3px;
    padding: 4px 10px; margin-bottom: 18px;
  }
  .skill-name {
    font-family: var(--serif); font-size: 22px;
    line-height: 1.2; color: var(--ink); margin-bottom: 10px;
  }
  .skill-desc {
    font-size: 13px; font-weight: 300; color: var(--ink2);
    line-height: 1.7;
  }
  .skill-tools {
    margin-top: 18px; display: flex; flex-wrap: wrap; gap: 8px;
  }
  .skill-tool-tag {
    font-size: 11px; font-weight: 500; letter-spacing: 0.04em;
    color: var(--ink); border: 1px solid var(--border);
    padding: 5px 12px; border-radius: 3px;
  }
  .skill-card.featured .skill-tool-tag {
    color: rgba(255,255,255,0.8); border-color: rgba(255,255,255,0.2);
  }

  /* ── INTERESTS ── */
  #interests { background: var(--ink); color: #fff; }
  #interests .section-h2 { color: #fff; }
  #interests .section-body { color: rgba(255,255,255,0.55); }
  #interests .section-label { color: var(--gold); }
  #interests .section-label::before { background: var(--gold); }
  .interests-grid {
    display: grid; grid-template-columns: repeat(2, 1fr);
    gap: 2px; margin-top: 56px;
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 8px; overflow: hidden;
  }
  .interest-item {
    padding: 40px 36px;
    border-right: 1px solid rgba(255,255,255,0.06);
    border-bottom: 1px solid rgba(255,255,255,0.06);
    transition: background 0.2s;
  }
  .interest-item:hover { background: rgba(255,255,255,0.03); }
  .interest-item:nth-child(2n) { border-right: none; }
  .interest-item:nth-child(3), .interest-item:nth-child(4) { border-bottom: none; }
  .interest-icon { font-size: 28px; margin-bottom: 16px; }
  .interest-title {
    font-family: var(--serif); font-size: 22px;
    color: #fff; margin-bottom: 10px;
  }
  .interest-desc {
    font-size: 14px; font-weight: 300; color: rgba(255,255,255,0.5);
    line-height: 1.7;
  }

  /* ── TAGS / TOOLS ── */
  .authority-tags { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 32px; }
  .atag {
    font-size: 12px; font-weight: 500; letter-spacing: 0.04em;
    color: var(--ink); border: 1px solid var(--border);
    padding: 8px 16px; border-radius: 3px;
    transition: background 0.15s, border-color 0.15s;
  }
  .atag:hover { background: var(--ink); color: #fff; border-color: var(--ink); cursor: default; }

  /* ── CTA ── */
  #cta {
    background: var(--ink); padding: 120px 60px;
    text-align: center;
  }
  #cta .section-label { justify-content: center; }
  #cta .section-label::before { display: none; }
  .cta-h2 {
    font-family: var(--serif);
    font-size: clamp(36px, 5vw, 64px);
    color: #fff; line-height: 1.1;
    margin-bottom: 20px;
  }
  .cta-h2 em { font-style: italic; color: var(--gold); }
  .cta-sub {
    font-size: 16px; font-weight: 300; color: rgba(255,255,255,0.55);
    max-width: 520px; margin: 0 auto 50px; line-height: 1.7;
  }
  .cta-buttons { display: flex; gap: 16px; justify-content: center; align-items: center; flex-wrap: wrap; }
  .btn-light {
    font-size: 14px; font-weight: 600; letter-spacing: 0.03em;
    background: #fff; color: var(--ink);
    padding: 16px 34px; border-radius: 4px;
    text-decoration: none;
    transition: background 0.2s, transform 0.15s;
  }
  .btn-light:hover { background: var(--warm); transform: translateY(-2px); }
  .btn-outline {
    font-size: 14px; font-weight: 500; letter-spacing: 0.03em;
    border: 1px solid rgba(255,255,255,0.25); color: rgba(255,255,255,0.8);
    padding: 16px 34px; border-radius: 4px;
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s, transform 0.15s;
  }
  .btn-outline:hover {
    border-color: rgba(255,255,255,0.6); color: #fff;
    transform: translateY(-2px);
  }
  .cta-note {
    margin-top: 28px; font-size: 12px; color: rgba(255,255,255,0.3);
    letter-spacing: 0.04em;
  }

  /* ── FOOTER ── */
  footer {
    background: var(--ink); border-top: 1px solid rgba(255,255,255,0.06);
    padding: 32px 60px;
    display: flex; justify-content: space-between; align-items: center;
  }
  .footer-logo {
    font-family: var(--display); font-size: 14px; font-weight: 800;
    letter-spacing: 0.08em; text-transform: uppercase; color: rgba(255,255,255,0.5);
  }
  .footer-copy { font-size: 12px; color: rgba(255,255,255,0.25); }

  /* ── ANIMATIONS ── */
  .fade-up {
    opacity: 0; transform: translateY(24px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .fade-up.visible { opacity: 1; transform: translateY(0); }

  /* ── RESPONSIVE ── */
  @media (max-width: 900px) {
    nav { padding: 18px 24px; }
    .nav-links { display: none; }
    section { padding: 80px 24px; }
    #about-hero { grid-template-columns: 1fr; padding: 120px 24px 80px; gap: 48px; }
    .about-hero-right { order: -1; }
    .photo-frame { width: 260px; }
    .summary-inner { grid-template-columns: 1fr; }
    .skills-grid { grid-template-columns: 1fr; }
    .interests-grid { grid-template-columns: 1fr; }
    #cta { padding: 80px 24px; }
    footer { padding: 24px; flex-direction: column; gap: 12px; text-align: center; }
  }
</style>
</head>
